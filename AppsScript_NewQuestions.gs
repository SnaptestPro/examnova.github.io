/**
 * MAIN DELETE + RE-ADD FUNCTION
 * Ye function run karo — pehle purane questions delete karega,
 * phir naye questions add karega.
 */
function deleteAndReplaceQuestions() {
  Logger.log("🗑️  STEP 1: Purane questions delete kar rahe hain...");
  const deleted = deleteAllQuestionBankDocs();
  Logger.log("✅ Delete complete. " + deleted + " documents delete hue.");
  Logger.log("");
  Logger.log("📚 STEP 2: Naye questions add kar rahe hain...");
  Utilities.sleep(1000); // 1 second wait
  addAllQuestions();
}

/**
 * Sirf ek specific chapter ke questions delete karo
 * Pehle CHAPTER_TO_DELETE variable set karo, phir run karo
 */
function deleteChapterQuestions() {
  const CHAPTER_TO_DELETE = "समाजवाद और साम्यवाद"; // ← YE CHANGE KARO
  
  Logger.log("🗑️ Chapter delete kar rahe hain: " + CHAPTER_TO_DELETE);
  const allDocs = getAllDocumentIds();
  let deleted = 0;
  
  allDocs.forEach(function(doc) {
    try {
      if (doc.chapter === CHAPTER_TO_DELETE) {
        deleteDocFromFirestore(doc.id);
        deleted++;
        Logger.log("  ❌ Deleted: " + doc.id + " — " + doc.chapter);
      }
    } catch(e) {
      Logger.log("  ⚠️ Failed: " + doc.id + " — " + e.message);
    }
  });
  
  Logger.log("✅ " + deleted + " questions delete hue chapter: " + CHAPTER_TO_DELETE);
}

/**
 * Saare questionBank documents delete karo
 */
function deleteAllQuestionBankDocs() {
  Logger.log("📋 Firestore se saare documents list kar rahe hain...");
  const allDocs = getAllDocumentIds();
  Logger.log("   Total documents found: " + allDocs.length);
  
  let deleted = 0, failed = 0;
  
  allDocs.forEach(function(doc, i) {
    try {
      deleteDocFromFirestore(doc.id);
      deleted++;
      if ((i + 1) % 20 === 0) {
        Logger.log("   ⏳ Deleted " + deleted + "/" + allDocs.length + "...");
        Utilities.sleep(200);
      }
    } catch(e) {
      failed++;
      Logger.log("   ⚠️ Failed to delete " + doc.id + ": " + e.message);
    }
  });
  
  Logger.log("   ✅ Deleted: " + deleted + " | ❌ Failed: " + failed);
  return deleted;
}

/**
 * Firestore se saare document IDs aur chapters fetch karo
 * (pagination ke saath — 300+ documents ke liye bhi kaam karega)
 */
function getAllDocumentIds() {
  const docs = [];
  let pageToken = null;
  
  do {
    let url = BASE_URL + "/questionBank?key=" + API_KEY + "&pageSize=300&mask.fieldPaths=chapter";
    if (pageToken) url += "&pageToken=" + pageToken;
    
    const res = UrlFetchApp.fetch(url, { muteHttpExceptions: true });
    const code = res.getResponseCode();
    if (code !== 200) {
      Logger.log("❌ List failed: HTTP " + code);
      break;
    }
    
    const data = JSON.parse(res.getContentText());
    if (data.documents) {
      data.documents.forEach(function(doc) {
        const parts = doc.name.split("/");
        const docId = parts[parts.length - 1];
        const chapter = doc.fields && doc.fields.chapter ? doc.fields.chapter.stringValue : "";
        docs.push({ id: docId, chapter: chapter });
      });
    }
    pageToken = data.nextPageToken || null;
  } while (pageToken);
  
  return docs;
}

/**
 * Ek document ko Firestore se delete karo
 */
function deleteDocFromFirestore(docId) {
  const url = BASE_URL + "/questionBank/" + docId + "?key=" + API_KEY;
  const res = UrlFetchApp.fetch(url, {
    method: "DELETE",
    muteHttpExceptions: true
  });
  const code = res.getResponseCode();
  if (code !== 200 && code !== 204) {
    throw new Error("HTTP " + code + ": " + res.getContentText().substring(0, 100));
  }
  return true;
}
