    ["मैजिनी का संबंध किस संगठन से था?",["लाल सेना","कार्बोनारी","फिलिक हेरारिया","डायर"],1,"यूरोप में राष्ट्रवाद","मैजिनी का संबंध कार्बोनारी संगठन से था।","Carbonari","Mazzini was associated with which organization?",["Red Army","Carbonari","Filik Heraria","Dyer"]],
    ["किसने अपनी कूटनीति के बल पर इटली की समस्या को सम्पूर्ण यूरोप की समस्या बना दिया?",["काउंट काबूर","गैरीबाल्डी","मैजिनी","विक्टर इमैनुएल"],0,"यूरोप में राष्ट्रवाद","काउंट काबूर ने अपनी कूटनीति से यह कार्य किया।","Count Cavour","Who made the Italian problem a European issue through diplomacy?",["Count Cavour","Garibaldi","Mazzini","Victor Emmanuel"]],
    ["'यंग इटली' का संस्थापक कौन था?",["काबूर","गैरीबाल्डी","मैजिनी","मुसोलिनी"],2,"यूरोप में राष्ट्रवाद","यंग इटली की स्थापना मैजिनी ने की थी।","Mazzini","Who founded Young Italy?",["Cavour","Garibaldi","Mazzini","Mussolini"]],
  ];

  // Convert raw array `[text, options, answer, chapter]` to Firebase object format
  let finalQuestions = [];
  let counter = 1;
  
  rawQuestions.forEach(q => {
    let subjectName = "General Knowledge";
    if (q[3] === "समाजवाद और साम्यवाद" || q[3] === "भारत में राष्ट्रवाद" || q[3] === "हिन्द-चीन में राष्ट्रवादी आंदोलन" || q[3] === "यूरोप में राष्ट्रवाद") {
      subjectName = "History";
    } else if (q[3] === "भूगोल") {
      subjectName = "Geography";
    } else if (q[3] === "सामान्य विज्ञान") {
      subjectName = "Science";
    } else if (q[3] === "Social Science") {
      subjectName = "Social Science";
    }

    // q format: [textHI, optionsHI, answer, chapter, explanationHI?, explanationEN?, textEN?, optionsEN?]
    const hasEN = q.length >= 8;

    finalQuestions.push({
      docId: `gk-ssc-${String(counter).padStart(4, "0")}`,
      subject: subjectName,
      chapter: q[3],
      textHI: q[0],
      textEN: hasEN ? q[6] : "",
      optionsHI: q[1],
      optionsEN: hasEN ? q[7] : [],
      answer: q[2],
      explanationHI: q[4] || ("Correct Answer: " + q[1][q[2]]),
      explanationEN: q[5] || ""
    });
    counter++;
  });

  return finalQuestions;
}


